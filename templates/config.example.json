{
  "schema_version": 2,
  "project": {
    "app_subdir": "",
    "command_prefix": ""
  },
  "commands": {
    "test": "npm test",
    "lint": "",
    "typecheck": "",
    "acceptance_runner": "npm test"
  },
  "providers": {
    "fake": {
      "adapter": "fake"
    },
    "codex": {
      "adapter": "codex-mcp",
      "tiers": [
        "sol",
        "terra",
        "luna"
      ],
      "ratelimit_signal": [
        "usage limit",
        "rate limit",
        "429"
      ],
      "pool": {
        "kind": "window",
        "reserve_floor": 0.1
      }
    },
    "claude": {
      "adapter": "claude-sdk",
      "auth": "login",
      "models": {
        "frontier": "claude-opus-5-5",
        "fast": "claude-haiku-5-5"
      },
      "pool": {
        "kind": "window",
        "reserve_floor": 0.25
      },
      "max_turns": 60
    }
  },
  "roles": {
    "implement": [
      "codex",
      "fake"
    ],
    "review": [
      "claude",
      "fake"
    ]
  },
  "routing": {
    "security_routed": [
      "src/auth/**"
    ],
    "do_not_touch": [],
    "attention": {
      "billing": [
        "src/billing/**"
      ]
    }
  },
  "pipeline": {
    "plans_dir": ".nexus/plans",
    "tasks_dir": ".nexus/specs",
    "ledger": "docs/nexus/manifest.md"
  },
  "automation": {
    "level": "manual",
    "max_fix_rounds": 2
  },
  "scheduler": {
    "max_concurrent_ships": 6,
    "max_concurrent_systems": 1,
    "per_provider_max": {}
  },
  "db": {
    "stats": false
  },
  "fleet": {
    "freighters": 6,
    "customs": 2,
    "carriers": 1,
    "surveyors": 1,
    "name_theme": "classic"
  }
}
